#!/usr/bin/env bash
# fortivpn — openfortivpn driver for the Omarchy shell plugin augusto2803.fortivpn.
#
# Profiles are plain openfortivpn config files owned by you, one per gateway,
# in ~/.config/fortivpn/profiles. Only the connect itself needs root; creating,
# editing, and deleting a profile never do.
#
# Run `fortivpn help` for the command list.

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fortivpn"
PROFILE_DIR="$CONFIG_DIR/profiles"
DEFAULT_FILE="$CONFIG_DIR/default"
IFNAME=fortivpn0
APP=FortiVPN

die() { echo "fortivpn: $*" >&2; exit 1; }
note() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
notify() { notify-send -a "$APP" -i network-vpn "$APP" "$1" 2>/dev/null || true; }

interactive() { [[ -t 0 && -t 1 ]]; }

need() { command -v "$1" >/dev/null || die "'$1' is required but not installed"; }

# ---------------------------------------------------------------- profiles

# Profile names become file names, so keep them to something that cannot
# escape PROFILE_DIR or confuse the shell.
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]; }

conf_path() { echo "$PROFILE_DIR/$1.conf"; }

list_profiles() {
  find "$PROFILE_DIR" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' 2>/dev/null |
    sed 's/\.conf$//' | sort
  return 0
}

default_profile() {
  local saved
  if [[ -r $DEFAULT_FILE ]]; then
    saved=$(<"$DEFAULT_FILE")
    saved=${saved//[[:space:]]/}
    [[ -n $saved && -f $(conf_path "$saved") ]] && { echo "$saved"; return 0; }
  fi
  list_profiles | head -n1
}

# Resolve an argument into a profile name: explicit name, else a gum picker
# when there is a terminal to show it in, else the default profile.
resolve_profile() {
  local name=${1:-} header=${2:-Profile:} profiles

  if [[ -n $name ]]; then
    valid_name "$name" || die "invalid profile name '$name'"
    [[ -f $(conf_path "$name") ]] || die "no profile named '$name' (try: fortivpn list)"
    echo "$name"; return 0
  fi

  profiles=$(list_profiles)
  [[ -z $profiles ]] && die "no profiles yet — create one with: fortivpn new"

  if [[ $(wc -l <<<"$profiles") -eq 1 ]] || ! interactive; then
    default_profile; return 0
  fi

  need gum
  gum choose --header "$header" <<<"$profiles"
}

# ---------------------------------------------------------------- conf files

get_key() {
  sed -nE "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*\$/\1/p" "$1" | head -n1
}

# Rewrite key in place, uncommenting an existing commented-out line, or append
# it. Written back through the original inode so mode 600 survives the edit.
set_key() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(mktemp) || die "could not create a temporary file"
  if grep -qE "^[[:space:]]*#?[[:space:]]*$key[[:space:]]*=" "$file"; then
    awk -v k="$key" -v v="$value" '
      !replaced && $0 ~ "^[[:space:]]*#?[[:space:]]*" k "[[:space:]]*=" { print k " = " v; replaced = 1; next }
      { print }
    ' "$file" >"$tmp"
  else
    cat "$file" >"$tmp"
    printf '%s = %s\n' "$key" "$value" >>"$tmp"
  fi
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

# ---------------------------------------------------------------- state

vpn_pid() { pgrep -x openfortivpn | head -n1; }

tunnel_ip() {
  ip -4 -o addr show dev "$IFNAME" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1
}

# The live profile is read off the running process, not a state file, so the
# indicator stays correct even for a tunnel someone brought up by hand.
active_conf() {
  local pid=$1 argv i
  [[ -z $pid ]] && return 0
  mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null || return 0
  for ((i = 0; i < ${#argv[@]}; i++)); do
    case ${argv[i]} in
      -c) echo "${argv[i + 1]:-}"; return 0 ;;
      --config=*) echo "${argv[i]#--config=}"; return 0 ;;
      -c?*) echo "${argv[i]#-c}"; return 0 ;;
    esac
  done
}

active_profile() {
  local conf
  conf=$(active_conf "$1")
  [[ -n $conf ]] && basename "$conf" .conf
}

uptime_seconds() {
  local pid=$1 secs
  [[ -z $pid ]] && { echo 0; return; }
  secs=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
  echo "${secs:-0}"
}

state() {
  if [[ -n $(tunnel_ip) ]]; then echo connected
  elif [[ -n $(vpn_pid) ]]; then echo connecting
  else echo disconnected
  fi
}

# ---------------------------------------------------------------- commands

cmd_status() {
  local st pid ip profile up
  pid=$(vpn_pid); ip=$(tunnel_ip); st=$(state)
  profile=$(active_profile "$pid"); up=$(uptime_seconds "$pid")
  [[ $st == disconnected ]] && { profile=""; up=0; }

  if [[ ${1:-} == --json ]]; then
    jq -nc \
      --arg state "$st" --arg profile "$profile" --arg ip "$ip" \
      --arg iface "$IFNAME" --argjson uptime "${up:-0}" \
      '{state: $state, profile: $profile, ip: $ip, iface: $iface, uptime: $uptime}'
    return 0
  fi

  echo "state:    $st"
  [[ -n $profile ]] && echo "profile:  $profile"
  [[ -n $ip ]] && echo "address:  $ip ($IFNAME)"
  [[ ${up:-0} -gt 0 ]] && echo "uptime:   $((up / 60))m"
  return 0
}

cmd_is_up() { [[ $(state) == connected ]]; }

# Runs in the foreground inside the floating terminal. openfortivpn needs a
# terminal because the password and then the 2FA token are typed here — a
# token that rotates every 30s cannot live in a config file.
cmd_run() {
  local profile=$1 conf status
  conf=$(conf_path "$profile")
  [[ -f $conf ]] || die "no profile named '$profile'"

  echo "Connecting to '$profile'…"
  echo "Type your password and, when prompted, the 2FA token. Ctrl+C ends the VPN."
  [[ -z $(get_key "$conf" trusted-cert) ]] &&
    warn "This profile has no trusted-cert yet. If the gateway certificate is rejected, run: fortivpn trust $profile"
  echo

  # --persistent is deliberately left out: with 2FA an automatic reconnect
  # would hang waiting for a fresh token that nobody is there to type.
  sudo openfortivpn -c "$conf" --pppd-ifname="$IFNAME"
  status=$?

  if ((status != 0)); then
    echo
    warn "openfortivpn exited with status $status"
    interactive && read -rsn1 -p "Press any key to close… "
  fi
  return "$status"
}

cmd_up() {
  local profile
  if cmd_is_up; then
    notify "Already connected ($(active_profile "$(vpn_pid)"))"
    return 0
  fi
  profile=$(resolve_profile "${1:-}" "Connect to:") || exit 1
  [[ -z $profile ]] && return 0
  omarchy-launch-floating-terminal-with-presentation "$(printf '%q %q %q' "$SELF" _run "$profile")"
}

cmd_down() {
  local pid
  pid=$(vpn_pid)
  [[ -z $pid ]] && { notify "No active connection"; return 0; }

  # SIGINT is openfortivpn's clean shutdown: it tears down the routes and the
  # DNS registration before exiting. SIGKILL would leave both behind.
  if sudo -n true 2>/dev/null; then
    sudo kill -INT "$pid"
  else
    pkexec /usr/bin/kill -INT "$pid"
  fi
}

cmd_toggle() { if cmd_is_up; then cmd_down; else cmd_up "${1:-}"; fi }

cmd_use() {
  local profile
  profile=$(resolve_profile "${1:-}" "Default profile:") || exit 1
  [[ -z $profile ]] && return 0
  mkdir -p "$CONFIG_DIR"
  echo "$profile" >"$DEFAULT_FILE"
  note "Default profile: $profile"
  notify "Default profile: $profile"
}

cmd_new() {
  local name="" host="" port=443 username="" set_routes=1

  while (($# > 0)); do
    case $1 in
      --host) host=${2:-}; shift 2 ;;
      --port) port=${2:-}; shift 2 ;;
      --username | --user) username=${2:-}; shift 2 ;;
      --split-tunnel) set_routes=0; shift ;;
      -*) die "unknown option for new: $1" ;;
      *) name=$1; shift ;;
    esac
  done

  if [[ -z $name ]]; then
    interactive || die "usage: fortivpn new <name> --host <gateway> --username <user>"
    need gum
    name=$(gum input --prompt "Profile name: " --placeholder work) || return 0
  fi
  [[ -n $name ]] || return 0
  valid_name "$name" || die "invalid profile name '$name' (letters, digits, . _ - only)"
  [[ -f $(conf_path "$name") ]] && die "profile '$name' already exists (edit it with: fortivpn edit $name)"

  if [[ -z $host ]]; then
    interactive || die "--host is required"
    need gum
    host=$(gum input --prompt "Gateway host: " --placeholder vpn.example.com) || return 0
  fi
  [[ -n $host ]] || die "gateway host is required"

  if [[ -z $username ]]; then
    interactive || die "--username is required"
    username=$(gum input --prompt "Username: " --value "$USER") || return 0
  fi
  [[ -n $username ]] || die "username is required"

  [[ $port =~ ^[0-9]+$ ]] || die "port must be a number"

  if interactive && command -v gum >/dev/null; then
    gum confirm "Route all traffic through the VPN (full tunnel)?" && set_routes=1 || set_routes=0
  fi

  mkdir -p "$PROFILE_DIR"
  chmod 700 "$CONFIG_DIR" "$PROFILE_DIR"

  local conf
  conf=$(conf_path "$name")
  (umask 077; write_profile "$conf" "$host" "$port" "$username" "$set_routes")
  chmod 600 "$conf"
  note "Created $conf"

  [[ -z $(default_profile) || $(list_profiles | wc -l) -eq 1 ]] && echo "$name" >"$DEFAULT_FILE"

  if interactive && command -v gum >/dev/null &&
    gum confirm "Fetch and pin the gateway's certificate fingerprint now?"; then
    cmd_trust "$name"
  else
    note "Pin the certificate later with: fortivpn trust $name"
  fi
}

write_profile() {
  local conf=$1 host=$2 port=$3 username=$4 set_routes=$5
  cat >"$conf" <<CONF
# openfortivpn profile '$(basename "$conf" .conf)'.
# Managed by the Omarchy FortiVPN plugin — see \`fortivpn help\`.

### Gateway ###################################################################

host = $host
port = $port

### Credentials ###############################################################

username = $username

# The password is deliberately absent. With 2FA it is useless on its own, and
# openfortivpn asks for the password and the token in the terminal at connect
# time. If your gateway has no 2FA and you want it stored, uncomment the line
# below — it is plain text, so keep this file at mode 600.
# password = ...

### Gateway certificate #######################################################

# Filled in by \`fortivpn trust\`. Until it is set, the first connection will
# be rejected and openfortivpn will print the digest to pin.
# trusted-cert = ...

### DNS and routes ############################################################

# With use-resolvconf the VPN's DNS servers are registered against the
# $IFNAME interface (real split-DNS) instead of overwriting
# /etc/resolv.conf system-wide. On systemd-resolved hosts /usr/bin/resolvconf
# is the resolvectl shim, so this is the right setting there too.
set-dns = 1
use-resolvconf = 1

# pppd can rewrite resolv.conf as well and races openfortivpn for it. Leaving
# it off keeps the two from fighting.
pppd-use-peerdns = 0

# 1 sends all traffic through the tunnel (full tunnel). Use 0 when the gateway
# already pushes the split-tunnel routes you need.
set-routes = $set_routes
CONF
}

cmd_edit() {
  local profile conf
  profile=$(resolve_profile "${1:-}" "Edit profile:") || exit 1
  [[ -z $profile ]] && return 0
  conf=$(conf_path "$profile")

  if interactive; then
    "${EDITOR:-nvim}" "$conf"
  else
    omarchy-launch-floating-terminal-with-presentation "$(printf '%q %q' "${EDITOR:-nvim}" "$conf")"
  fi
}

cmd_delete() {
  local profile conf assume_yes=0 args=()

  for arg in "$@"; do
    case $arg in
      --yes | -y) assume_yes=1 ;;
      *) args+=("$arg") ;;
    esac
  done

  profile=$(resolve_profile "${args[0]:-}" "Delete profile:") || exit 1
  [[ -z $profile ]] && return 0
  conf=$(conf_path "$profile")

  [[ $profile == $(active_profile "$(vpn_pid)") ]] &&
    warn "'$profile' is the profile currently connected; the tunnel stays up until you disconnect"

  if ((!assume_yes)); then
    interactive || die "refusing to delete without confirmation; pass --yes"
    need gum
    gum confirm "Delete profile '$profile'? This cannot be undone." || return 0
  fi

  rm -f "$conf"
  note "Deleted $conf"

  # A default pointing at a profile that no longer exists would silently
  # resolve to some other gateway, so retire it with the file.
  [[ -r $DEFAULT_FILE && $(<"$DEFAULT_FILE") == "$profile" ]] && rm -f "$DEFAULT_FILE"
  notify "Deleted profile '$profile'"
  return 0
}

cmd_rename() {
  local old new
  old=$(resolve_profile "${1:-}" "Rename profile:") || exit 1
  [[ -z $old ]] && return 0

  new=${2:-}
  if [[ -z $new ]]; then
    interactive || die "usage: fortivpn rename <old> <new>"
    need gum
    new=$(gum input --prompt "New name: " --value "$old") || return 0
  fi
  [[ -n $new && $new != "$old" ]] || return 0
  valid_name "$new" || die "invalid profile name '$new'"
  [[ -f $(conf_path "$new") ]] && die "profile '$new' already exists"

  mv "$(conf_path "$old")" "$(conf_path "$new")"
  note "Renamed '$old' to '$new'"
  [[ -r $DEFAULT_FILE && $(<"$DEFAULT_FILE") == "$old" ]] && echo "$new" >"$DEFAULT_FILE"
  return 0
}

# Pin the gateway's certificate. openfortivpn compares trusted-cert against the
# SHA256 of the peer's DER-encoded certificate, which is exactly what this
# computes — so pinning here is the same check, done before the first connect
# instead of after a failed one.
cmd_trust() {
  local profile conf host port digest
  profile=$(resolve_profile "${1:-}" "Pin certificate for:") || exit 1
  [[ -z $profile ]] && return 0
  conf=$(conf_path "$profile")

  need openssl
  host=$(get_key "$conf" host)
  port=$(get_key "$conf" port); port=${port:-443}
  [[ -n $host ]] || die "profile '$profile' has no host set"

  note "Fetching the certificate from $host:$port"
  digest=$(openssl s_client -connect "$host:$port" -servername "$host" </dev/null 2>/dev/null |
    openssl x509 -outform DER 2>/dev/null | sha256sum | awk '{print $1}')

  [[ $digest =~ ^[0-9a-f]{64}$ ]] || die "could not read a certificate from $host:$port"

  set_key "$conf" trusted-cert "$digest"
  note "Pinned trusted-cert = $digest"
}

cmd_help() {
  cat <<'USAGE'
fortivpn — FortiGate SSL VPN control for Omarchy

Connection
  fortivpn up [profile]        Connect in a floating terminal (password + 2FA token)
  fortivpn down                Disconnect, tearing down routes and DNS cleanly
  fortivpn toggle [profile]    Connect when down, disconnect when up
  fortivpn status [--json]     Profile, tunnel address, uptime
  fortivpn is-up               Exit 0 while the tunnel is up

Profiles  (~/.config/fortivpn/profiles/<name>.conf, mode 600)
  fortivpn list                List profiles
  fortivpn new [name] [opts]   Create a profile  (--host --port --username --split-tunnel)
  fortivpn edit [profile]      Open a profile in $EDITOR
  fortivpn delete [profile]    Delete a profile  (--yes to skip the prompt)
  fortivpn rename <old> [new]  Rename a profile
  fortivpn use [profile]       Set the default profile
  fortivpn trust [profile]     Pin the gateway's certificate fingerprint

Omitting [profile] opens a picker in a terminal, and uses the default profile
elsewhere.
USAGE
}

# ---------------------------------------------------------------- dispatch

SELF=$(readlink -f "${BASH_SOURCE[0]}")

case "${1:-status}" in
  status) shift; cmd_status "$@" ;;
  is-up) cmd_is_up ;;
  up | connect) shift; cmd_up "$@" ;;
  down | disconnect) cmd_down ;;
  toggle) shift; cmd_toggle "$@" ;;
  list | profiles) list_profiles ;;
  use) shift; cmd_use "$@" ;;
  new | create | add) shift; cmd_new "$@" ;;
  edit) shift; cmd_edit "$@" ;;
  delete | remove | rm) shift; cmd_delete "$@" ;;
  rename | mv) shift; cmd_rename "$@" ;;
  trust) shift; cmd_trust "$@" ;;
  help | --help | -h) cmd_help ;;
  _run) shift; cmd_run "$@" ;;
  *) die "unknown command '$1' (try: fortivpn help)" ;;
esac
